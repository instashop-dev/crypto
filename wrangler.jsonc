{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crypto-arb",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crypto-arb",
      "database_id": "a4a8557a-02e9-44d2-953b-fe66f7d86825",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
